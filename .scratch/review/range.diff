+        String token = createInvite(admin, "{\"type\":0}");
+        Long inviteId = jdbc.queryForObject(
+                "SELECT id FROM invite_link WHERE token_hash = SHA2(?, 256)", Long.class, token);
+
+        doThrow(new IllegalStateException("outbox unavailable"))
