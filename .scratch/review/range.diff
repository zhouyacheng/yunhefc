+
+class MessagingReliabilityIT extends IntegrationTestSupport {
+
+    private static final String AUDIT_TOPIC = "yunhefc.audit.events";
+    private static final String NOTIFICATION_TOPIC = "yunhefc.notification.events";
+
+    @Autowired
