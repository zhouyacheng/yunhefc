+                .withSchedule(CronScheduleBuilder.cronSchedule(properties.getExpiryCron())
+                        .inTimeZone(TimeZone.getTimeZone(properties.getZone()))
+                        .withMisfireHandlingInstructionDoNothing())
+                .build();
+    }
