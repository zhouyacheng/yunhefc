+                                {"code":"COACH","name":"教练","permissions":["lineup:view:any","grouping:view:any"]}
+                                """))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.data.code").value("COACH"))
+                .andReturn();
+        Number roleId = JsonPath.read(created.getResponse().getContentAsString(), "$.data.id");
