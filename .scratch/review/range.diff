+                        .content("{\"type\":0}"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.data.inviteUrl").isNotEmpty())
+                .andReturn();
+
+        MvcResult replay = mockMvc.perform(post("/api/v1/b/invites")
+                        .cookie(admin)
+                        .with(csrf())
+                        .header("Idempotency-Key", "idem-invite-1")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"type\":0}"))
