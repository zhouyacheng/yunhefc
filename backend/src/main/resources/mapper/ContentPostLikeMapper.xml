<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunhefc.content.infrastructure.ContentPostLikeMapper">

    <select id="selectActiveCounts"
            resultType="com.yunhefc.content.infrastructure.ContentPostLikeCountRow">
        SELECT post_id AS postId, COUNT(*) AS likeCount
        FROM content_post_like
        WHERE is_deleted = 0
          AND post_id IN
          <foreach collection="postIds" item="postId" open="(" separator="," close=")">
              #{postId}
          </foreach>
        GROUP BY post_id
    </select>

    <select id="selectLikedPostIds" resultType="java.lang.Long">
        SELECT post_id
        FROM content_post_like
        WHERE user_id = #{userId}
          AND is_deleted = 0
          AND post_id IN
          <foreach collection="postIds" item="postId" open="(" separator="," close=")">
              #{postId}
          </foreach>
    </select>

</mapper>
