# 复制为 /opt/yunhefc/.env（chmod 600）后填入真实值；真实值不入库。
# release.sh 用同一份文件做 compose 变量替换，后端从该文件读取运行时配置。

# ---- 站点与域名 ----
DOMAIN=example.com
PUBLIC_BASE_URL=https://www.example.com

# ---- 会话/CORS（prod 启动自检：Secure=true、Domain 为空、CORS 恰为两个 https 域名）----
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com

# ---- 阿里云 RDS MySQL 8.4（私网；应用账号只有 DML）----
DB_URL=jdbc:mysql://rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/yunhefc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=yunhefc_app
DB_PASSWORD=__CHANGE_ME__

# ---- Redis / Kafka（仅 Compose 内网，不发布端口）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- 短信（阿里云云市场；生产必须关闭 mock）----
SMS_MOCK_ENABLED=false
SMS_ENDPOINT=https://gyytz.market.alicloudapi.com/sms/smsSend
SMS_APPCODE=__CHANGE_ME__
SMS_TEMPLATE_ID=__CHANGE_ME__
SMS_SIGN_ID=__CHANGE_ME__

# ---- 微信网页授权（回调固定在 www 同源路径）----
WECHAT_ENABLED=true
WECHAT_MODE=real
WECHAT_APP_ID=__CHANGE_ME__
WECHAT_APP_SECRET=__CHANGE_ME__
WECHAT_CALLBACK_URL=https://www.example.com/api/v1/c/auth/wechat/callback
WECHAT_ALLOWED_REDIRECT_PREFIXES=https://www.example.com/
WECHAT_REQUIRE_UA=true

# ---- 阿里云 OSS（私有 Bucket；生产必须 real）----
OSS_MODE=real
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=__CHANGE_ME__
OSS_ACCESS_KEY_ID=__CHANGE_ME__
OSS_ACCESS_KEY_SECRET=__CHANGE_ME__

# ---- 审计年度导出与数据保留（默认值即可，按需覆盖）----
AUDIT_EXPORT_ENABLED=false
# RETENTION_NOTIFICATION_DAYS=90
# RETENTION_INVITE_DAYS=30
# RETENTION_OUTBOX_DAYS=7
# RETENTION_CONSUMED_EVENT_DAYS=7
