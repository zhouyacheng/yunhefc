server {
    listen 80;
    listen [::]:80;
    server_name www.${DOMAIN} admin.${DOMAIN} api.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    server_tokens off;
    client_max_body_size 3m;
    root /usr/share/nginx/html/www;
    index index.html;

    include /etc/nginx/snippets/spa-locations.conf;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.${DOMAIN};

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    server_tokens off;
    client_max_body_size 3m;
    root /usr/share/nginx/html/admin;
    index index.html;

    include /etc/nginx/snippets/spa-locations.conf;
}

# 直连别名：只放行 /api/ 与 /actuator/health，其余 404。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    server_tokens off;
    client_max_body_size 3m;

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://backend:8080;
    }

    location = /actuator/health {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://backend:8080/actuator/health;
    }

    location / {
        return 404;
    }
}
