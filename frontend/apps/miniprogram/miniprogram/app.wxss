@import "styles/tokens.wxss";
@import "styles/controls.wxss";
@import "styles/layout.wxss";
@import "styles/match-card.wxss";

page {
  background: var(--yh-bg);
  color: var(--yh-ink);
  font-size: 28rpx;
  font-family: 'Inter', 'PingFang SC', 'Microsoft YaHei', ui-sans-serif, system-ui, sans-serif;
}

.container {
  padding: var(--yh-page-pad-y) var(--yh-page-pad-x);
}

.card {
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.muted {
  color: var(--yh-muted);
  font-size: 24rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--yh-muted);
}
