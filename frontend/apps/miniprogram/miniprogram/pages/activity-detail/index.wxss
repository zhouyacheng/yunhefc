.activity-detail {
  padding-bottom: calc(var(--yh-page-pad-y) + env(safe-area-inset-bottom));
}

/* 与 C03 比赛 Hero 同一视觉语言：深色渐变、白字。 */
.detail-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 52rpx;
  margin-bottom: 36rpx;
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(circle at 50% -20%, rgba(22, 163, 74, 0.35), transparent 42%),
    linear-gradient(135deg, var(--yh-navy), var(--yh-navy-2) 60%, #0f2a24);
  border-radius: 40rpx;
  box-shadow: var(--yh-shadow);
}

.detail-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-hero__type {
  color: #cbd5e1;
  font-size: 24rpx;
}

.detail-hero__tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-hero__title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.detail-hero__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 44rpx;
  color: #cbd5e1;
  font-size: 26rpx;
  line-height: 1.6;
}

.detail-hero__meta text {
  white-space: nowrap;
}

/* 分享按钮：深色 Hero 内的浅色描边胶囊，尺寸贴合文本。 */
.detail-share {
  box-sizing: border-box;
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: auto;
  padding: 6rpx 16rpx;
  margin: 0;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.detail-share::after {
  border: none;
}

.detail-share--pressed {
  opacity: 0.86;
}

.overview-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.card-title {
  color: var(--yh-ink);
  font-size: 34rpx;
  font-weight: 700;
}

.activity-gallery {
  margin-bottom: 36rpx;
}

.gallery-image {
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  object-fit: cover;
  border-radius: var(--yh-radius-sm);
}

.gallery-stage {
  position: relative;
}

.gallery-nav {
  position: absolute;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 1;
  background: rgba(15, 23, 42, 0.45);
  border-radius: 50%;
  transform: translateY(-50%);
}

.gallery-nav--prev {
  left: 16rpx;
}

.gallery-nav--next {
  right: 16rpx;
}

.description-text {
  color: var(--yh-ink);
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.signup-track {
  height: 12rpx;
  overflow: hidden;
  background: var(--yh-line);
  border-radius: 999rpx;
}

.signup-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--yh-green), var(--yh-green-bright));
  border-radius: inherit;
  transition: width 0.2s ease;
}

/* 与 C 端 Vant Button 口径一致：主按钮渐变绿，次按钮绿字浅灰描边。 */
.signup-card .btn--outline {
  color: var(--yh-green);
  border-color: var(--yh-line);
}

.signup-card__mine {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  color: var(--yh-green-ink);
  font-size: 28rpx;
  font-weight: 600;
  background: var(--yh-green-soft);
  border-radius: var(--yh-radius-sm);
}

.signup-sheet {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
}

.signup-sheet__title {
  color: var(--yh-ink);
  font-size: 32rpx;
  font-weight: 700;
}

.signup-sheet__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--yh-line);
}

.signup-sheet__label {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 28rpx;
}

.signup-sheet__actions {
  display: flex;
  gap: 16rpx;
}

.signup-sheet__actions .btn {
  flex: 1;
}

/* 报名队列：按报名时间升序，与比赛名单行同一视觉语言。 */
.activity-signup-list {
  margin-top: 8rpx;
}

.activity-signup-list__row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  background: var(--yh-surface-soft);
  border-radius: var(--yh-radius-sm);
}

.activity-signup-list__order {
  flex: 0 0 auto;
  min-width: 36rpx;
  color: var(--yh-muted);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.activity-signup-list__avatar {
  flex: 0 0 auto;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.activity-signup-list__avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--yh-green-ink);
  font-size: 26rpx;
  font-weight: 700;
  background: var(--yh-green-soft);
}

.activity-signup-list__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.activity-signup-list__name {
  display: flex;
  gap: 12rpx;
  align-items: baseline;
  font-size: 26rpx;
  font-weight: 600;
}

.activity-signup-list__family {
  color: var(--yh-muted);
  font-size: 22rpx;
}

.activity-signup-list__mine {
  flex: 0 0 auto;
  padding: 2rpx 12rpx;
  color: var(--yh-green-ink);
  font-size: 20rpx;
  font-weight: 700;
  background: var(--yh-green-soft);
  border-radius: 999rpx;
}

/* ACT-13 管理员状态修改：状态胶囊可点，底部状态面板复用 status-sheet 组件。 */
.status-pill--action {
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.status-pill--pressed {
  opacity: 0.75;
}
