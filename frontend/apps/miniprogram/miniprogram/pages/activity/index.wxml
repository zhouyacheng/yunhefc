<view class="container activities">
  <view class="page-head">
    <text class="page-head__eyebrow">TEAM DAYS</text>
    <view class="page-head__title">活动</view>
  </view>

  <view class="filters">
    <view class="segmented">
      <view
        wx:for="{{scopeOptions}}"
        wx:key="key"
        class="segmented__item {{scope === item.key ? 'segmented__item--active' : ''}}"
        data-scope="{{item.key}}"
        bindtap="selectScope"
      >{{item.label}}</view>
    </view>

    <view class="filters__pickers">
      <picker
        mode="selector"
        range="{{typeOptions}}"
        range-key="label"
        value="{{typeIndex}}"
        bindchange="onTypeChange"
      >
        <view class="filter-chip">{{typeOptions[typeIndex].label}} ▾</view>
      </picker>
      <picker
        mode="selector"
        range="{{statusOptions}}"
        range-key="label"
        value="{{statusIndex}}"
        bindchange="onStatusChange"
      >
        <view class="filter-chip">{{statusOptions[statusIndex].label}} ▾</view>
      </picker>
      <picker
        mode="date"
        fields="month"
        start="{{timeFilterMin}}"
        end="{{timeFilterMax}}"
        value="{{monthPickerDraft}}"
        bindchange="onMonthChange"
      >
        <view class="filter-chip">{{month || '全部月份'}} ▾</view>
      </picker>
      <text wx:if="{{month}}" class="filter-chip filter-chip--clear" bindtap="clearMonth">清除</text>
      <text wx:else class="filter-chip" bindtap="selectCurrentMonth">本月</text>
      <view class="filter-chip filter-chip--range" bindtap="openRange">
        {{startDate && endDate ? startDate + ' 至 ' + endDate : '自定义时间'}} ▾
      </view>
    </view>
  </view>

  <view wx:if="{{feed.loading && feed.items.length === 0}}" class="state">
    <van-loading size="20px">加载中…</van-loading>
  </view>

  <view wx:elif="{{feed.error && feed.items.length === 0}}" class="state">
    <text class="muted">{{feed.error}}</text>
    <view class="btn btn--primary btn--small" bindtap="retry" hover-class="btn--pressed">重试</view>
  </view>

  <view wx:elif="{{feed.loaded && feed.items.length === 0}}" class="state">
    <van-empty description="{{emptyText}}" />
  </view>

  <view wx:else class="activity-list">
    <view
      class="activity-card"
      wx:for="{{feed.items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
      hover-class="card--pressed"
    >
      <image
        wx:if="{{item.imageUrl}}"
        class="activity-card__image"
        src="{{item.imageUrl}}"
        mode="aspectFill"
      />
      <view class="activity-card__head">
        <text class="activity-card__title">{{item.title}}</text>
        <text class="status-pill status-pill--{{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <text class="activity-card__type">{{item.typeText}}</text>
      <view class="emoji-row activity-card__line">
        <view class="emoji-icon">📅</view>
        <text class="activity-card__line-text">{{item.timeText}}</text>
      </view>
      <view class="emoji-row activity-card__line">
        <view class="emoji-icon">📍</view>
        <text class="activity-card__line-text">{{item.locationText}}</text>
      </view>
      <view class="activity-card__foot">
        <view class="muted emoji-row">
          <view class="emoji-icon">👥</view>
          <text>{{item.countText}}</text>
        </view>
        <text
          wx:if="{{item.actionVisible}}"
          class="activity-card__action {{item.actionDisabled ? 'activity-card__action--disabled' : ''}}"
        >{{item.actionLabel}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{feed.items.length > 0}}" class="feed-footer">
    <van-loading wx:if="{{feed.loadingMore}}" size="18px">加载中…</van-loading>
    <block wx:elif="{{feed.error}}">
      <text class="muted">{{feed.error}}</text>
      <view class="btn btn--small btn--outline" bindtap="retry" hover-class="btn--pressed">重试加载</view>
    </block>
    <text wx:elif="{{feed.page >= feed.totalPages}}" class="muted">已显示全部</text>
    <text wx:else class="muted">上拉加载更多</text>
  </view>
</view>

<van-popup show="{{rangeOpen}}" position="bottom" round bind:close="closeRange">
  <view class="range-sheet">
    <view class="filter-drawer__head">
      <text class="filter-drawer__title">自定义时间</text>
    </view>

    <view class="filter-field">
      <text class="filter-field__label">开始日期</text>
      <picker mode="date" value="{{rangeDraftStart}}" start="{{timeFilterMin}}" end="{{timeFilterMax}}" bindchange="onRangeStartChange">
        <view class="filter-field__value">{{rangeDraftStart || '选择开始日期'}}</view>
      </picker>
    </view>

    <view class="filter-field">
      <text class="filter-field__label">结束日期</text>
      <picker mode="date" value="{{rangeDraftEnd}}" start="{{timeFilterMin}}" end="{{timeFilterMax}}" bindchange="onRangeEndChange">
        <view class="filter-field__value">{{rangeDraftEnd || '选择结束日期'}}</view>
      </picker>
    </view>

    <view class="filter-drawer__actions range-sheet__actions">
      <view class="btn btn--small btn--outline" bindtap="clearRange" hover-class="btn--pressed">清除</view>
      <view class="btn btn--small btn--primary" bindtap="confirmRange" hover-class="btn--pressed">确定</view>
    </view>
  </view>
</van-popup>
