.activities {
  padding-bottom: calc(var(--yh-page-pad-y) + env(safe-area-inset-bottom));
}

.filters {
  margin-bottom: 24rpx;
}

.segmented {
  display: inline-flex;
  padding: 6rpx;
  background: var(--yh-slate-soft);
  border-radius: 20rpx;
}

.segmented__item {
  padding: 12rpx 16rpx;
  color: var(--yh-muted);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  border-radius: 16rpx;
}

.segmented__item--active {
  color: var(--yh-ink);
  background: var(--yh-surface);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
}

.filters__pickers {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.filter-chip {
  padding: 12rpx 24rpx;
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: 999rpx;
  white-space: nowrap;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 与 templates/match-card.wxss 的 .match-card 同一卡片语言。 */
.activity-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 36rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.activity-card__image {
  width: 100%;
  height: 280rpx;
  border-radius: var(--yh-radius-sm);
}

.activity-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.activity-card__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--yh-ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-card__type {
  color: var(--yh-green);
  font-size: 24rpx;
  font-weight: 600;
}

.activity-card__line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
}

/* 与人数行同一口径：emoji 用 view 承载才生效 transform。 */
.activity-card__line-icon {
  flex: none;
  font-size: 24rpx;
  line-height: 1;
  transform: translateY(-2rpx);
}

.activity-card__line-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--yh-line);
}

/* emoji 与中文基线不同，拆成两个盒子后按中线对齐。 */
.activity-card__count {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

/* Apple Color Emoji 的墨迹重心比中文低约 1px（26rpx 字号下 2rpx），按视觉中线做光学校正。
   必须是 view：WebView 渲染下 <text> 的行内节点不生效 transform。 */
.activity-card__count-icon {
  font-size: 26rpx;
  line-height: 1;
  transform: translateY(-2rpx);
}

/* 与 C 端 .activity-cta 同一口径：绿底白字胶囊。 */
.activity-card__action {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 60rpx;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  background: var(--yh-green);
  border-radius: 999rpx;
}

.activity-card__action--disabled {
  color: var(--yh-muted);
  background: var(--yh-slate-soft);
}

.feed-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0 16rpx;
}
