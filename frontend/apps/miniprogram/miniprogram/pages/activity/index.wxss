.filters {
  margin-bottom: 24rpx;
}

.segmented {
  display: inline-flex;
  padding: 6rpx;
  background: var(--yh-slate-soft);
  border-radius: 20rpx;
}

.segmented__item {
  min-height: 72rpx;
  padding: 10rpx 28rpx;
  color: var(--yh-muted);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 52rpx;
  border-radius: 16rpx;
}

.segmented__item--active {
  color: var(--yh-ink);
  background: var(--yh-surface);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
}

.filters__pickers {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.filter-chip {
  padding: 12rpx 24rpx;
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: 999rpx;
  white-space: nowrap;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.activity-card__thumb {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--yh-radius-sm);
}

.activity-card__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.activity-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.activity-card__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--yh-ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-card__type {
  color: var(--yh-green);
  font-size: 24rpx;
  font-weight: 600;
}

.activity-card__line {
  overflow: hidden;
  color: var(--yh-muted);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.activity-card__action {
  padding: 8rpx 20rpx;
  color: var(--yh-green-ink);
  font-size: 24rpx;
  font-weight: 700;
  background: var(--yh-green-soft);
  border-radius: 999rpx;
}

.activity-card__action--disabled {
  color: var(--yh-muted);
  background: var(--yh-slate-soft);
}

.feed-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0 16rpx;
}
