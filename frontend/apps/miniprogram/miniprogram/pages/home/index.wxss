.home {
  min-height: 100vh;
  background: var(--yh-bg);
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 160rpx 40rpx;
}

/* Hero */

.hero {
  padding: 64rpx var(--yh-page-pad-x) 56rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 78% 18%, rgba(22, 163, 74, 0.2), transparent 34%),
    linear-gradient(120deg, var(--yh-navy) 0%, var(--yh-navy-2) 58%, #0f2a24 100%);
}

.hero__copy {
  margin-bottom: 48rpx;
}

.hero__eyebrow {
  display: block;
  color: var(--yh-gold);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.hero__title {
  margin: 16rpx 0 24rpx;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.03em;
}

.hero__tagline {
  color: #cbd5e1;
  font-size: 30rpx;
  line-height: 1.7;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 44rpx;
}

/* Buttons: 基础与主色按钮见 styles/controls.wxss；此处仅 Hero 深色底变体。 */

.btn--ghost {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

/* Hero card */

.hero-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 40rpx;
  color: var(--yh-ink);
  background: var(--yh-surface);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow);
}

.hero-card__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 与 C01 一致：Hero 类型用绿色 uppercase eyebrow，不是 pill。 */
.hero-card__eyebrow {
  color: var(--yh-green);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.hero-card__teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 24rpx;
  align-items: center;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.hero-card__score {
  color: var(--yh-green);
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -0.03em;
  white-space: nowrap;
}

.hero-card__meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: var(--yh-muted);
  font-size: 26rpx;
  text-align: center;
}

.hero-card__ordinal {
  font-size: 22rpx;
}

/* Queue */

.queue {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.queue__item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
}

.queue__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.queue__count {
  color: var(--yh-ink);
  font-size: 26rpx;
  font-weight: 700;
}

.progress {
  height: 16rpx;
  overflow: hidden;
  background: var(--yh-line);
  border-radius: 999rpx;
}

.progress__bar {
  height: 100%;
  background: linear-gradient(90deg, var(--yh-green), var(--yh-green-bright));
  border-radius: 999rpx;
}

/* CTA */

.cta {
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  background: linear-gradient(135deg, var(--yh-green-bright), var(--yh-green));
  border-radius: var(--yh-radius-sm);
  box-shadow: var(--yh-green-shadow);
}

.cta--disabled {
  color: var(--yh-muted);
  background: var(--yh-slate-soft);
  box-shadow: none;
}

.hint {
  color: var(--yh-muted);
  font-size: 26rpx;
  text-align: center;
}

.ghost-link {
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.link--pressed {
  opacity: 0.7;
}

/* Pills: 基础与状态/类型配色见 styles/controls.wxss；此处仅 Hero 强调。 */
.hero-card .status-pill--finished {
  color: #ffffff;
  background: var(--yh-indigo-ink);
  font-size: 24rpx;
  font-weight: 800;
}

/* Body sections */

.home-body {
  padding: 40rpx var(--yh-page-pad-x) calc(40rpx + env(safe-area-inset-bottom));
}

.home-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  text-align: center;
}

.home-empty__text {
  font-size: 24rpx;
  line-height: 1.6;
}

.section {
  margin-top: 64rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.section-head__title {
  color: var(--yh-ink);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}

/* Recent matches: 卡片结构样式见 styles/match-card.wxss。 */

.quick-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 64rpx;
  padding: 24rpx 28rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

/* 第二个起紧贴上一个快捷入口，避免与首段间距 64rpx 叠加。 */
.quick-entry + .quick-entry {
  margin-top: 20rpx;
}

.quick-entry__icon {
  width: 68rpx;
  height: 68rpx;
  font-size: 32rpx;
  line-height: 68rpx;
  text-align: center;
  background: var(--yh-surface-soft);
  border-radius: var(--yh-radius-sm);
}

.quick-entry__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.quick-entry__title {
  color: var(--yh-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.quick-entry__arrow {
  color: var(--yh-green);
  font-size: 30rpx;
  font-weight: 700;
}
