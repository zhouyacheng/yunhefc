.lb-head {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 48rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.lb-window {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin-left: auto;
  color: var(--yh-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.lb-window__select {
  display: inline-flex;
  align-items: center;
  min-height: 68rpx;
  white-space: nowrap;
  padding: 12rpx 18rpx;
  color: var(--yh-ink);
  font-size: 26rpx;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: 18rpx;
}

.lb-tabs {
  display: flex;
  gap: 8rpx;
  margin: 32rpx 0 28rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 2rpx solid var(--yh-line);
}

.lb-tab {
  flex: 0 0 auto;
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  color: var(--yh-muted);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border-bottom: 4rpx solid transparent;
}

.lb-tab--active {
  color: var(--yh-ink);
  font-weight: 700;
  border-bottom-color: var(--yh-green);
}

.lb-board {
  overflow: hidden;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.lb-board-head {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding: 16rpx 24rpx;
  color: var(--yh-muted);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--yh-surface-soft);
  border-bottom: 1rpx solid var(--yh-line);
}

.lb-board-head--single {
  grid-template-columns: 1fr;
}

.lb-head-stat {
  text-align: center;
  white-space: nowrap;
}

.lb-head-stat:first-child {
  color: var(--yh-green);
}

.lb-list {
  display: block;
}

.lb-row {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
}

.lb-row + .lb-row {
  border-top: 1rpx solid var(--yh-line);
}

.lb-main-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-width: 0;
}

.lb-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--yh-line);
}

.lb-stats--single {
  grid-template-columns: 1fr;
}

.lb-stat {
  text-align: center;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.lb-stat--current {
  color: var(--yh-green);
  font-size: 34rpx;
  font-weight: 800;
}

.lb-stat--history {
  color: var(--yh-muted);
  font-size: 28rpx;
  font-weight: 600;
}

.lb-stat--career {
  color: var(--yh-ink);
  font-size: 30rpx;
  font-weight: 800;
}

.lb-stat--zero {
  color: var(--yh-muted);
  font-weight: 500;
}

.lb-rank {
  flex: none;
  width: 56rpx;
  color: var(--yh-muted);
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.lb-rank--top {
  color: var(--yh-gold);
}

.lb-avatar {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  object-fit: cover;
  background: var(--yh-slate-soft);
}

.lb-avatar--fallback {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--yh-green);
  font-size: 28rpx;
  font-weight: 800;
}

.lb-info {
  display: flex;
  flex: 1;
  gap: 8rpx;
  align-items: baseline;
  min-width: 0;
}

.lb-name {
  overflow: hidden;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}


.lb-note {
  display: block;
  margin-top: 36rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
  line-height: 1.7;
}
