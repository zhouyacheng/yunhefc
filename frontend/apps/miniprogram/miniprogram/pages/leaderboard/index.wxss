.lb-head {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 48rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.lb-window {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin-left: auto;
  color: var(--yh-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.lb-window__select {
  display: inline-flex;
  align-items: center;
  min-height: 68rpx;
  white-space: nowrap;
  padding: 12rpx 18rpx;
  color: var(--yh-ink);
  font-size: 26rpx;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: 18rpx;
}

.lb-tabs {
  display: flex;
  gap: 8rpx;
  margin: 32rpx 0 28rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 2rpx solid var(--yh-line);
}

.lb-tab {
  flex: 0 0 auto;
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  color: var(--yh-muted);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border-bottom: 4rpx solid transparent;
}

.lb-tab--active {
  color: var(--yh-ink);
  font-weight: 700;
  border-bottom-color: var(--yh-green);
}

.lb-board {
  overflow: hidden;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.lb-board-head {
  padding-top: 14rpx;
  padding-bottom: 14rpx;
  color: var(--yh-muted);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--yh-surface-soft);
  border-bottom: 1rpx solid var(--yh-line);
}

/* 表头与行共用的五列网格；列宽与间距必须保持一致。 */
.lb-grid {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr) 108rpx 94rpx 94rpx;
  column-gap: 8rpx;
  align-items: center;
  padding-right: 16rpx;
  padding-left: 16rpx;
}

.lb-head-rank,
.lb-head-stat {
  text-align: center;
  white-space: nowrap;
}

.lb-head-player {
  white-space: nowrap;
}

.lb-head-stat--current {
  color: var(--yh-green);
}

.lb-list {
  display: block;
}

.lb-row {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.lb-row + .lb-row {
  border-top: 1rpx solid var(--yh-line);
}

.lb-rank {
  color: var(--yh-muted);
  font-size: 30rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.lb-rank--top {
  color: var(--yh-gold);
}

.lb-player {
  display: flex;
  gap: 10rpx;
  align-items: center;
  min-width: 0;
  overflow: hidden;
}

.lb-avatar {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  object-fit: cover;
  background: var(--yh-slate-soft);
}

.lb-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--yh-green);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.lb-name {
  flex: 1 1 auto;
  overflow: hidden;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lb-stat {
  font-variant-numeric: tabular-nums;
  text-align: center;
  white-space: nowrap;
}

.lb-stat--current {
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 800;
}

.lb-stat--history {
  color: var(--yh-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.lb-stat--career {
  color: var(--yh-ink);
  font-size: 24rpx;
  font-weight: 800;
}

/* 必须位于三个具体样式之后，靠 source order 覆盖颜色与字重。 */
.lb-stat--zero {
  color: var(--yh-muted);
  font-weight: 500;
}


.lb-note {
  display: block;
  margin-top: 36rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.lb-note-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--yh-ink);
  font-size: 26rpx;
  font-weight: 600;
}

.lb-note-body {
  display: block;
}
