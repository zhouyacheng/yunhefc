.summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.summary__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.summary__label {
  color: var(--yh-muted);
  font-size: 24rpx;
}

.summary__value {
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
}

.summary__value--income {
  color: var(--yh-green);
}

.summary__value--expense {
  color: var(--yh-red);
}

.ledger-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ledger-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
}

.ledger-row__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.ledger-row__category {
  color: var(--yh-ink);
  font-size: 28rpx;
  font-weight: 700;
}

.ledger-row__amount {
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
}

.ledger-row__amount--income {
  color: var(--yh-green);
}

.ledger-row__amount--expense {
  color: var(--yh-red);
}

.ledger-row__desc {
  color: var(--yh-ink);
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.feed-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0 16rpx;
}
