<view class="login">
  <view class="pitch">
    <view class="pitch__ring"></view>
    <view class="pitch__axis"></view>

    <view class="pitch__body">
      <view class="crest">
        <image class="crest__img" src="/assets/logo.png" mode="aspectFit" />
      </view>
      <text class="pitch__eyebrow">SHANGHAI YUNHE FC</text>
      <view class="pitch__title">云河FC</view>
    </view>
  </view>

  <view class="panel">
    <view class="panel__head">
      <text class="panel__title">欢迎回来</text>
      <text class="panel__sub">使用手机号或微信登录</text>
    </view>

    <view class="field {{focus === 'phone' ? 'field--focus' : ''}}">
      <text class="field__label">手机号</text>
      <input
        class="field__input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入手机号"
        placeholder-class="field__placeholder"
        data-field="phone"
        bindinput="onPhoneInput"
        bindfocus="onFieldFocus"
        bindblur="onFieldBlur"
      />
    </view>

    <view class="field {{focus === 'password' ? 'field--focus' : ''}}">
      <text class="field__label">密码</text>
      <input
        class="field__input"
        password
        maxlength="64"
        value="{{password}}"
        placeholder="请输入密码"
        placeholder-class="field__placeholder"
        data-field="password"
        bindinput="onPasswordInput"
        bindfocus="onFieldFocus"
        bindblur="onFieldBlur"
      />
    </view>

    <agreement-consent checked="{{agreed}}" bind:change="onAgreementChange" />

    <view class="form-error" wx:if="{{error}}">{{error}}</view>

    <view
      class="btn btn--primary btn--block submit {{wechatLoading ? 'is-blocked' : ''}}"
      bindtap="submit"
      hover-class="btn--pressed"
    >{{submitting ? '登录中…' : '登录'}}</view>

    <view class="divider">
      <view class="divider__line"></view>
      <text class="divider__text">或</text>
      <view class="divider__line"></view>
    </view>

    <view
      class="btn btn--outline btn--block wechat {{submitting ? 'is-blocked' : ''}}"
      bindtap="wechatLogin"
      hover-class="btn--pressed"
    >{{wechatLoading ? '正在登录…' : '微信一键登录'}}</view>
    <text class="panel__hint">首次微信登录需绑定手机号</text>

    <view class="skip" bindtap="skip" hover-class="link--pressed">先逛逛</view>
  </view>
</view>
