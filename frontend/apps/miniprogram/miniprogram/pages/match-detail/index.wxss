.hero {
  text-align: left;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.status {
  font-size: 22rpx;
  color: var(--yh-green-ink);
  background: var(--yh-green-soft);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.score {
  font-size: 56rpx;
