.detail {
  padding-bottom: calc(var(--yh-page-pad-y) + env(safe-area-inset-bottom));
}

/* C03 头部：深色渐变，与首页 Hero 同一视觉语言。 */

.detail-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 52rpx;
  margin-bottom: 36rpx;
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(circle at 50% -20%, rgba(22, 163, 74, 0.35), transparent 42%),
    linear-gradient(135deg, var(--yh-navy), var(--yh-navy-2) 60%, #0f2a24);
  border-radius: 40rpx;
  box-shadow: var(--yh-shadow);
}

.detail-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-hero__type {
  color: #cbd5e1;
  font-size: 24rpx;
}

.detail-hero__tools {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

/* 分享按钮：深色 Hero 内的浅色描边胶囊，与活动详情同款。 */
.detail-share {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.detail-share--pressed {
  opacity: 0.86;
}

.detail-hero__teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 24rpx;
  align-items: center;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  text-align: center;
}

.detail-hero__score {
  color: var(--yh-gold);
  font-size: 80rpx;
  font-weight: 900;
  letter-spacing: -0.06em;
  white-space: nowrap;
}

.detail-hero__result {
  display: flex;
  justify-content: center;
}

.detail-hero__banner {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  color: var(--yh-amber-soft);
  font-size: 24rpx;
  line-height: 1.6;
  background: rgba(245, 196, 81, 0.14);
  border: 1rpx solid rgba(245, 196, 81, 0.4);
  border-radius: var(--yh-radius-sm);
}

.detail-hero__banner--danger {
  color: var(--yh-red-soft);
  background: rgba(220, 38, 38, 0.16);
  border-color: rgba(220, 38, 38, 0.5);
}

.detail-hero__banner-sub {
  color: #cbd5e1;
  font-size: 22rpx;
}

.detail-hero__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 44rpx;
  color: #cbd5e1;
  font-size: 26rpx;
  line-height: 1.6;
}

.detail-hero__meta text {
  white-space: nowrap;
}

.section-title {
  margin: 40rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
}

/* 事件时间线：与 C 端移动端一致，左侧时间轴 + 右侧事件卡。 */

.team-timeline {
  display: flex;
  flex-direction: column;
}

.timeline-row {
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: flex-start;
  padding: 20rpx 0;
}

.timeline-axis {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.timeline-axis::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  content: '';
  background: var(--yh-line);
  transform: translateX(-50%);
}

.timeline-time {
  position: relative;
  z-index: 1;
  padding: 2rpx 12rpx;
  color: var(--yh-muted);
  font-size: 22rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: 999rpx;
  white-space: nowrap;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  width: 16rpx;
  height: 16rpx;
  background: var(--yh-green);
  border-radius: 50%;
}

.timeline-side {
  display: flex;
  justify-content: flex-start;
}

.event-card {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 100%;
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  background: var(--yh-surface-soft);
  border: 2rpx solid var(--yh-line);
  border-radius: 24rpx;
}

.event-card--home {
  border-right: 6rpx solid var(--yh-event-home);
}

.event-card--away {
  border-left: 6rpx solid var(--yh-blue);
}

.event-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.event-card__type {
  color: var(--yh-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.event-card__detail {
  color: var(--yh-ink);
  font-size: 24rpx;
  line-height: 1.4;
}

.event-card__team {
  color: var(--yh-muted);
  font-size: 24rpx;
}

.event-edit {
  color: var(--yh-green);
  font-size: 24rpx;
}

.status-pill--action {
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.status-pill--pressed {
  opacity: 0.75;
}

.detail-tabs {
  display: flex;
  gap: 8rpx;
  margin: 44rpx 0 36rpx;
  padding: 0;
  overflow-x: auto;
  background: transparent;
  border-bottom: 2rpx solid var(--yh-line);
}

.detail-tab {
  flex: 0 0 auto;
  min-width: 144rpx;
  min-height: 88rpx;
  padding: 24rpx 32rpx;
  color: var(--yh-muted);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  background: transparent;
  border-bottom: 4rpx solid transparent;
}

.detail-tab--active {
  color: var(--yh-ink);
  font-weight: 700;
  background: transparent;
  border-bottom-color: var(--yh-green);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
}

.registration-card,
.roster-card,
.events-summary,
.events-panel,
.card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.overview-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.overview-grid .card {
  margin-bottom: 0;
}

.roster-hint {
  color: var(--yh-muted);
}

.hero-queue {
  display: grid;
  gap: 16rpx;
}

.hero-queue__item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
}

.hero-queue__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-queue__value {
  color: var(--yh-ink);
  font-size: 26rpx;
  font-weight: 700;
}

.progress {
  height: 16rpx;
  overflow: hidden;
  background: var(--yh-line);
  border-radius: 999rpx;
}

.progress__bar {
  height: 100%;
  background: linear-gradient(90deg, var(--yh-green), var(--yh-green-bright));
  border-radius: 999rpx;
}

.attendance-status {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  background: var(--yh-green-soft);
  border-radius: var(--yh-radius-sm);
}

.notice {
  padding: 16rpx 20rpx;
  color: var(--yh-amber-ink);
  font-size: 24rpx;
  line-height: 1.5;
  background: var(--yh-amber-soft);
  border: 1rpx solid var(--yh-amber-line);
  border-radius: var(--yh-radius-sm);
}

.action-error {
  color: var(--yh-red-ink);
  font-size: 24rpx;
}

.form-error {
  color: var(--yh-red-ink);
  font-size: 24rpx;
}

.roster-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.roster-warning {
  padding: 18rpx 20rpx;
  color: var(--yh-amber-ink);
  font-size: 24rpx;
  background: var(--yh-amber-soft);
  border-radius: var(--yh-radius-sm);
}

.roster-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--yh-line);
}

.roster-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.roster-section__title {
  font-size: 26rpx;
  font-weight: 700;
}

.roster-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  background: var(--yh-surface-soft);
  border-radius: var(--yh-radius-sm);
}

.roster-row__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.roster-row__name {
  display: flex;
  gap: 12rpx;
  align-items: baseline;
  font-size: 26rpx;
  font-weight: 600;
}

.roster-order {
  color: var(--yh-amber);
  font-size: 22rpx;
  white-space: nowrap;
}

.roster-attendance {
  color: var(--yh-muted);
  font-size: 22rpx;
  text-align: right;
}

.event-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.lineup-summary,
.lineup-panel {
  margin-bottom: 24rpx;
}

.lineup-side-switch {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0 12rpx;
}

.lineup-side {
  flex: 1;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  color: var(--yh-ink);
  font-size: 24rpx;
  text-align: center;
  background: var(--yh-surface-soft);
  border: 1rpx solid var(--yh-line);
  border-radius: 18rpx;
}

.lineup-side--active {
  color: #ffffff;
  background: var(--yh-green);
  border-color: var(--yh-green);
}

.lineup-pitch {
  position: relative;
  width: 100%;
  height: 1050rpx;
  margin: 0 auto;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.045) 50%, transparent 50%),
    repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.035) 0 8.333%,
      transparent 8.333% 16.666%
    ),
    linear-gradient(160deg, var(--yh-pitch-from), var(--yh-pitch-to));
  border-radius: var(--yh-radius);
}

.lineup-pitch-line {
  position: absolute;
  top: 50%;
  right: 8%;
  left: 8%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.45);
}

.lineup-pitch-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 26%;
  height: 0;
  padding-bottom: 26%;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.lineup-slot {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 92rpx;
  padding: 4rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 20rpx;
  background: rgba(15, 23, 42, 0.55);
  border: 1rpx dashed rgba(255, 255, 255, 0.65);
  border-radius: 20rpx;
  transform: translate(-50%, -50%);
}

.lineup-slot--filled {
  color: var(--yh-ink);
  background: var(--yh-surface-soft);
  border-color: var(--yh-ink);
  border-style: solid;
}

.lineup-slot__jersey {
  font-size: 24rpx;
  font-weight: 800;
}

.lineup-slot__name {
  max-width: 104rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lineup-slot__empty {
  color: rgba(248, 250, 252, 0.85);
}

.lineup-bench {
  margin-top: 28rpx;
}

.lineup-bench-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.lineup-bench-item {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  background: var(--yh-surface-soft);
  border: 1rpx solid var(--yh-line);
  border-radius: 999rpx;
}

.grouping-summary,
.grouping-panel {
  margin-bottom: 24rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--yh-surface-soft);
  border-radius: var(--yh-radius-sm);
}

.stat-tile__value {
  color: var(--yh-green);
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.stat-tile__label {
  color: var(--yh-muted);
  font-size: 22rpx;
}

.grouping-warnings {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.grouping-warning {
  padding: 16rpx 20rpx;
  color: var(--yh-amber-ink);
  font-size: 24rpx;
  line-height: 1.5;
  background: var(--yh-amber-soft);
  border-radius: 18rpx;
}

/* 与 C 端移动端一致：分组列纵向排列。 */
.grouping-board {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.grouping-column {
  padding: 28rpx;
  background: var(--yh-surface-soft);
  border: 1rpx solid var(--yh-line);
  border-radius: 24rpx;
}

.grouping-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.grouping-head__title {
  font-size: 28rpx;
  font-weight: 700;
}

.grouping-position {
  margin-bottom: 16rpx;
}

.grouping-position__title {
  margin: 12rpx 0 8rpx;
  color: var(--yh-muted);
  font-size: 22rpx;
  font-weight: 600;
}

.grouping-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: 18rpx;
}

.grouping-row__label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grouping-row__meta {
  display: inline-flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

.grouping-row__score {
  color: var(--yh-muted);
  font-size: 22rpx;
}

.grouping-distribution {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.grouping-distribution__row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  background: var(--yh-surface-soft);
  border-radius: 18rpx;
}

.grouping-distribution__label {
  color: var(--yh-muted);
  font-size: 22rpx;
}

.grouping-distribution__value {
  font-size: 26rpx;
  font-weight: 700;
}

.btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}

.hint {
  color: var(--yh-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.small {
  font-size: 22rpx;
}
