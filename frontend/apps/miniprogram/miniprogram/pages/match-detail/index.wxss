.detail {
  padding-bottom: calc(var(--yh-page-pad-y) + env(safe-area-inset-bottom));
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 40rpx;
}

.state--inline {
  padding: 48rpx 0;
}

/* C03 头部：深色渐变，与首页 Hero 同一视觉语言。 */

.detail-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx;
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(circle at 50% -20%, rgba(22, 163, 74, 0.35), transparent 42%),
    linear-gradient(135deg, var(--yh-navy), var(--yh-navy-2) 60%, #0f2a24);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow);
}

.detail-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-hero__type {
  color: #cbd5e1;
  font-size: 24rpx;
}

.detail-hero__teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 20rpx;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.detail-hero__score {
  color: var(--yh-gold);
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -0.06em;
  white-space: nowrap;
}

.detail-hero__result {
  display: flex;
  justify-content: center;
}

.detail-hero__banner {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  color: var(--yh-amber-soft);
  font-size: 24rpx;
  line-height: 1.6;
  background: rgba(245, 196, 81, 0.14);
  border: 1rpx solid rgba(245, 196, 81, 0.4);
  border-radius: var(--yh-radius-sm);
}

.detail-hero__banner--danger {
  color: var(--yh-red-soft);
  background: rgba(220, 38, 38, 0.16);
  border-color: rgba(220, 38, 38, 0.5);
}

.detail-hero__banner-sub {
  color: #cbd5e1;
  font-size: 22rpx;
}

.detail-hero__meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #cbd5e1;
  font-size: 24rpx;
  line-height: 1.7;
}

.section-title {
  margin: 40rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
}

/* 事件时间线：移动端单列。 */

.timeline {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.timeline__row {
  display: grid;
  grid-template-columns: 120rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: flex-start;
}

.timeline__time {
  padding-top: 20rpx;
  color: var(--yh-muted);
  font-size: 22rpx;
  text-align: right;
  white-space: nowrap;
}

.event-card {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-left: 6rpx solid var(--yh-event-home);
  border-radius: var(--yh-radius-sm);
  box-shadow: var(--yh-shadow-sm);
}

.event-card--away {
  border-left-color: var(--yh-blue);
}

.event-card__type {
  color: var(--yh-ink);
  font-size: 26rpx;
  font-weight: 700;
}

.event-card__detail {
  color: var(--yh-ink);
  font-size: 26rpx;
}

.event-card__team {
  color: var(--yh-muted);
  font-size: 22rpx;
}
