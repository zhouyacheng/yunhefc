<view class="container">
  <view class="card">
    <view class="title">绑定手机号</view>
    <view class="muted">手机号已注册时会直接关联已有账号；姓名与位置仅首次注册需要填写。</view>

    <van-cell-group inset custom-class="form-group">
      <van-field label="手机号" type="number" maxlength="11" value="{{phone}}" placeholder="请输入手机号" bind:change="onPhoneInput" />
      <van-field label="验证码" type="number" maxlength="6" value="{{code}}" placeholder="6 位验证码" bind:change="onCodeInput">
        <van-button slot="button" size="small" type="primary" disabled="{{countdown > 0 || sending}}" bind:click="sendCode">
          {{countdown > 0 ? countdown + 's' : (sending ? '发送中' : '获取验证码')}}
        </van-button>
      </van-field>
      <van-field label="姓名" maxlength="32" value="{{name}}" placeholder="首次注册必填" bind:change="onNameInput" />
      <van-cell title="主位置" is-link>
        <picker slot="right-icon" mode="selector" range="{{positionLabels}}" value="{{positionIndex}}" bindchange="onPositionChange">
          <view class="picker-value">{{positionLabels[positionIndex]}}</view>
        </picker>
      </van-cell>
    </van-cell-group>

    <view class="error" wx:if="{{error}}">{{error}}</view>

    <van-button class="btn" type="primary" block loading="{{submitting}}" bind:click="submit">绑定并浏览</van-button>
    <van-button class="btn" block bind:click="skip">先逛逛</van-button>
  </view>
</view>
