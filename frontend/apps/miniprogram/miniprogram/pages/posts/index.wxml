<view class="container content-page">
  <view wx:if="{{access === 'loading'}}" class="state">
    <van-loading size="20px">加载中…</van-loading>
  </view>

  <view wx:elif="{{access === 'guest'}}" class="state card">
    <van-empty description="登录后查看动态与相册" />
    <text class="muted">动态与相册仅对球队成员开放。</text>
    <view class="btn btn--primary btn--small" bindtap="goLogin" hover-class="btn--pressed">去登录</view>
  </view>

  <view wx:elif="{{access === 'pending'}}" class="state card">
    <van-empty description="账号待审核，暂不能查看动态与相册" />
    <text class="muted">通过审核后即可查看动态与相册。</text>
  </view>

  <view wx:elif="{{access === 'blocked'}}" class="state card">
    <van-empty description="动态与相册仅正式球员与管理员可见" />
  </view>

  <block wx:else>
    <view class="segmented content-tabs">
      <view
        class="segmented__item {{activeTab === 'timeline' ? 'segmented__item--active' : ''}}"
        data-tab="timeline"
        bindtap="selectTab"
      >时间线</view>
      <view
        class="segmented__item {{activeTab === 'albums' ? 'segmented__item--active' : ''}}"
        data-tab="albums"
        bindtap="selectTab"
      >相册</view>
    </view>

    <!-- 时间线 -->
    <block wx:if="{{activeTab === 'timeline'}}">
      <view class="card composer">
        <textarea
          class="composer__input"
          value="{{composerText}}"
          maxlength="{{postMaxLength}}"
          placeholder="说点什么，或者选一个相册分享照片…"
          bindinput="onComposerInput"
        />
        <view class="composer__row">
          <picker
            range="{{albumChoiceLabels}}"
            value="{{albumChoiceIndex}}"
            bindchange="onAlbumChoiceChange"
          >
            <view class="composer__picker">引用相册：{{albumChoiceLabels[albumChoiceIndex]}} ▾</view>
          </picker>
          <text class="muted">{{composerLength}}/{{postMaxLength}}</text>
          <view
            class="btn btn--primary btn--small {{canPublish ? '' : 'btn--disabled'}}"
            bindtap="publish"
            hover-class="btn--pressed"
          >{{publishing ? '发布中…' : '发布'}}</view>
        </view>
        <text wx:if="{{composerError}}" class="action-error">{{composerError}}</text>
      </view>

      <view wx:if="{{postsLoading}}" class="state">
        <van-loading size="20px">加载中…</van-loading>
      </view>

      <view wx:elif="{{postsError && !posts.length}}" class="state">
        <text class="muted">{{postsError}}</text>
        <view class="btn btn--primary btn--small" bindtap="retryTimeline" hover-class="btn--pressed">重试</view>
      </view>

      <view wx:elif="{{!posts.length}}" class="state">
        <van-empty description="暂无动态" />
      </view>

      <block wx:else>
        <view
          wx:for="{{posts}}"
          wx:key="id"
          id="post-{{item.id}}"
          class="card post {{focusPostId === item.id ? 'post--focus' : ''}}"
        >
          <view class="post__head">
            <view class="post__avatar">
              <image
                wx:if="{{item.avatarUrl}}"
                class="post__avatar-img"
                src="{{item.avatarUrl}}"
                mode="aspectFill"
                data-index="{{index}}"
                binderror="onAvatarError"
              />
              <text wx:else class="post__avatar-initial">{{item.authorInitial}}</text>
            </view>
            <view class="post__meta">
              <text class="post__author">{{item.authorName}}</text>
              <text class="muted">{{item.timeText}}</text>
            </view>
          </view>

          <text class="post__text">{{item.content}}</text>

          <view
            wx:if="{{item.album}}"
            class="post__album"
            data-id="{{item.album.id}}"
            bindtap="openAlbum"
            hover-class="card--pressed"
          >
            <view class="post__cover">
              <image
                wx:if="{{item.album.coverUrl && !coverBroken[item.album.coverUrl]}}"
                class="post__cover-img"
                src="{{item.album.coverUrl}}"
                mode="aspectFill"
                data-url="{{item.album.coverUrl}}"
                binderror="onCoverError"
              />
              <text wx:else class="muted">{{item.album.coverUrl ? '图片加载失败' : '暂无封面'}}</text>
            </view>
            <view class="post__album-main">
              <text class="post__album-title">{{item.album.title}}</text>
              <text class="muted">{{item.album.ownerText}} · {{item.album.photoCountText}}</text>
            </view>
          </view>

          <view class="post__actions">
            <view
              class="post__action {{item.likedByMe ? 'post__action--active' : ''}}"
              data-id="{{item.id}}"
              bindtap="toggleLike"
              hover-class="post__action--pressed"
            >♥ {{item.likeCount}}</view>
            <view
              class="post__action"
              data-id="{{item.id}}"
              bindtap="reportPost"
              hover-class="post__action--pressed"
            >举报</view>
            <view
              wx:if="{{item.canDelete}}"
              class="post__action post__action--danger"
              data-id="{{item.id}}"
              bindtap="removePost"
              hover-class="post__action--pressed"
            >删除</view>
          </view>
        </view>

        <view class="list-foot">
          <text wx:if="{{postsError}}" class="muted" bindtap="retryTimeline">{{postsError}}（点击重试）</text>
          <text wx:elif="{{postsMoreLoading}}" class="muted">加载中…</text>
          <text wx:elif="{{postPage >= postTotalPages}}" class="muted">没有更多了</text>
          <text wx:else class="muted">上拉加载更多</text>
        </view>
      </block>
    </block>

    <!-- 相册 -->
    <block wx:else>
      <view class="albums-head">
        <view class="albums-head__copy">
          <text class="albums-head__title">相册</text>
          <text wx:if="{{scopeText}}" class="muted">仅显示「{{scopeText}}」的相册</text>
        </view>
        <view class="albums-head__actions">
          <view
            wx:if="{{scopeText}}"
            class="btn btn--small btn--outline"
            bindtap="clearScope"
            hover-class="btn--pressed"
          >查看全部</view>
          <view
            class="btn btn--small btn--primary"
            bindtap="openCreate"
            hover-class="btn--pressed"
          >新建相册</view>
        </view>
      </view>

      <view wx:if="{{albumsLoading}}" class="state">
        <van-loading size="20px">加载中…</van-loading>
      </view>

      <view wx:elif="{{albumsError && !albums.length}}" class="state">
        <text class="muted">{{albumsError}}</text>
        <view class="btn btn--primary btn--small" bindtap="retryAlbums" hover-class="btn--pressed">重试</view>
      </view>

      <view wx:elif="{{!albums.length}}" class="state">
        <van-empty description="暂无相册" />
      </view>

      <block wx:else>
        <view
          wx:for="{{albums}}"
          wx:key="id"
          class="card album-card"
          data-id="{{item.id}}"
          bindtap="openAlbum"
          hover-class="card--pressed"
        >
          <view class="album-card__cover">
            <image
              wx:if="{{item.coverUrl && !coverBroken[item.coverUrl]}}"
              class="album-card__cover-img"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              data-url="{{item.coverUrl}}"
              binderror="onCoverError"
            />
            <text wx:else class="muted">{{item.coverUrl ? '图片加载失败' : '暂无封面'}}</text>
          </view>
          <view class="album-card__body">
            <text class="album-card__title">{{item.title}}</text>
            <text class="muted">{{item.ownerText}} · {{item.photoCountText}}</text>
            <text class="muted">{{item.timeText}}</text>
          </view>
          <view
            wx:if="{{canManageAlbums}}"
            class="album-card__delete"
            data-id="{{item.id}}"
            data-title="{{item.title}}"
            catchtap="removeAlbum"
            hover-class="btn--pressed"
          >删除</view>
        </view>

        <view class="list-foot">
          <text wx:if="{{albumsError}}" class="muted" bindtap="retryAlbums">{{albumsError}}（点击重试）</text>
          <text wx:elif="{{albumsMoreLoading}}" class="muted">加载中…</text>
          <text wx:elif="{{albumPage >= albumTotalPages}}" class="muted">没有更多了</text>
          <text wx:else class="muted">上拉加载更多</text>
        </view>
      </block>
    </block>

    <van-popup show="{{createOpen}}" position="bottom" round bind:close="closeCreate">
      <view class="create-sheet">
        <text class="create-sheet__title">新建相册</text>
        <van-field
          value="{{newAlbumTitle}}"
          label="相册名称"
          maxlength="{{albumTitleMax}}"
          placeholder="1–64 字"
          bind:change="onTitleInput"
        />
        <picker
          range="{{matchOptionLabels}}"
          value="{{newMatchIndex}}"
          bindchange="onMatchPick"
        >
          <view class="field-row">
            <text class="field-row__label">关联比赛</text>
            <text class="field-row__value">{{matchOptionLabels[newMatchIndex]}} ▾</text>
          </view>
        </picker>
        <picker
          range="{{activityOptionLabels}}"
          value="{{newActivityIndex}}"
          bindchange="onActivityPick"
        >
          <view class="field-row">
            <text class="field-row__label">关联活动</text>
            <text class="field-row__value">{{activityOptionLabels[newActivityIndex]}} ▾</text>
          </view>
        </picker>
        <text wx:if="{{optionsLoading}}" class="muted">关联对象加载中…</text>
        <text class="muted">比赛与活动只能选一个；都不选即球队通用相册。</text>
        <text wx:if="{{createError}}" class="action-error">{{createError}}</text>
        <view class="create-sheet__actions">
          <view class="btn btn--small btn--outline" bindtap="closeCreate" hover-class="btn--pressed">取消</view>
          <view
            class="btn btn--small btn--primary {{creating ? 'btn--disabled' : ''}}"
            bindtap="submitCreate"
            hover-class="btn--pressed"
          >{{creating ? '创建中…' : '创建'}}</view>
        </view>
      </view>
    </van-popup>
  </block>
</view>
