.edit {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.avatar-card {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.avatar-picker {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  overflow: hidden;
  background: var(--yh-navy);
  border-radius: 50%;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  color: var(--yh-gold);
  font-size: 56rpx;
  font-weight: 800;
}

.avatar-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.small {
  font-size: 24rpx;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--yh-surface-soft);
  border-radius: var(--yh-radius-sm);
}

.field--column {
  flex-direction: column;
  align-items: stretch;
}

.field__label {
  color: var(--yh-ink);
  font-size: 28rpx;
}

.field__input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  font-size: 28rpx;
  line-height: 56rpx;
  text-align: right;
}

.field__value {
  color: var(--yh-green-ink);
  font-size: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 28rpx;
  color: var(--yh-slate-ink);
  font-size: 26rpx;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: 999rpx;
}

.chip--active {
  color: var(--yh-green-ink);
  background: var(--yh-green-soft);
  border-color: var(--yh-green-soft);
}

.chip--disabled {
  opacity: 0.4;
}

.item--pressed {
  opacity: 0.75;
}

.hint {
  color: var(--yh-muted);
  font-size: 24rpx;
}

.action-error {
  color: var(--yh-red);
  font-size: 24rpx;
}

.hint-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  justify-content: space-between;
}
