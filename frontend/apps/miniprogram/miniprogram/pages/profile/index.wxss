.profile {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.notice {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  color: var(--yh-amber-ink);
  font-size: 26rpx;
  background: var(--yh-amber-soft);
  border-radius: var(--yh-radius-sm);
}

.empty-account {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.identity {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  align-items: center;
}

.avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  background: var(--yh-navy);
  border-radius: 50%;
}

.avatar__img {
  width: 100%;
  height: 100%;
}

.avatar__initial {
  color: var(--yh-gold);
  font-size: 52rpx;
  font-weight: 800;
}

.identity__info {
  flex: 1;
  min-width: 0;
}

.identity__name-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.identity__name {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.identity__phone {
  display: block;
  margin: 8rpx 0;
  font-size: 24rpx;
}

.identity__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  align-items: center;
  color: var(--yh-muted);
  font-size: 26rpx;
}

.identity__edit {
  width: 100%;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.section-head__title {
  font-size: 34rpx;
  font-weight: 700;
}

.small {
  font-size: 24rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.section__segment {
  margin-bottom: 24rpx;
}

.text-action {
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
}

.text-action--disabled {
  color: var(--yh-muted);
}

.list {
  display: flex;
  flex-direction: column;
}

.notification {
  display: flex;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx dashed var(--yh-line);
}

.notification:last-child {
  border-bottom: 0;
}

.notification__dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  background: var(--yh-green);
  border-radius: 50%;
}

.notification__main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.notification__title {
  color: var(--yh-muted);
  font-size: 32rpx;
  font-weight: 700;
}

.notification--unread .notification__title {
  color: var(--yh-ink);
  font-weight: 700;
}

.notification__body {
  color: var(--yh-slate-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.notification__meta {
  color: var(--yh-muted);
  font-size: 24rpx;
}

.registration {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx dashed var(--yh-line);
}

.registration:last-child {
  border-bottom: 0;
}

.registration__head,
.registration__foot {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: space-between;
}

.registration__title {
  min-width: 0;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.registration__cancel {
  align-self: flex-start;
}

.btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}

.list-more {
  display: block;
  margin: 20rpx auto 0;
}

.item--pressed {
  opacity: 0.75;
}

.hint {
  display: block;
  margin-bottom: 12rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
}

.action-error {
  display: block;
  margin-bottom: 12rpx;
  color: var(--yh-red);
  font-size: 24rpx;
}

.security-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx dashed var(--yh-line);
}
