.profile {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0;
}

.state--inline {
  padding: 32rpx 0;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-head__eyebrow {
  display: block;
  color: var(--yh-green-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.page-head__title {
  margin: 8rpx 0 6rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.notice {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  color: var(--yh-amber-ink);
  font-size: 26rpx;
  background: var(--yh-amber-soft);
  border-radius: var(--yh-radius-sm);
}

.empty-account {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.identity {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  background: var(--yh-navy);
  border-radius: 50%;
}

.avatar__img {
  width: 100%;
  height: 100%;
}

.avatar__initial {
  color: var(--yh-gold);
  font-size: 48rpx;
  font-weight: 800;
}

.identity__info {
  flex: 1;
  min-width: 0;
}

.identity__name-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.identity__name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.identity__phone {
  display: block;
  margin: 8rpx 0;
  font-size: 24rpx;
}

.identity__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  align-items: center;
  color: var(--yh-muted);
  font-size: 24rpx;
}

.stars {
  position: relative;
  display: inline-block;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}

.stars__base {
  color: var(--yh-line);
}

.stars__fill {
  position: absolute;
  top: 0;
  left: 0;
  overflow: hidden;
  color: var(--yh-gold);
  white-space: nowrap;
}

.identity__edit {
  flex: none;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-head__title {
  font-size: 32rpx;
  font-weight: 700;
}

.small {
  font-size: 24rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.segmented {
  display: flex;
  padding: 4rpx;
  background: var(--yh-surface-soft);
  border-radius: var(--yh-radius-sm);
}

.segmented__item {
  padding: 10rpx 22rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 8rpx;
}

.segmented__item--active {
  color: var(--yh-green-ink);
  background: var(--yh-green-soft);
}

.section__segment {
  margin-bottom: 16rpx;
}

.text-action {
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
}

.list {
  display: flex;
  flex-direction: column;
}

.notification {
  display: flex;
  gap: 14rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--yh-line);
}

.notification:last-child {
  border-bottom: 0;
}

.notification__dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  background: var(--yh-green);
  border-radius: 50%;
}

.notification__main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.notification__title {
  color: var(--yh-muted);
  font-size: 28rpx;
  font-weight: 600;
}

.notification--unread .notification__title {
  color: var(--yh-ink);
  font-weight: 700;
}

.notification__body {
  color: var(--yh-slate-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.notification__meta {
  color: var(--yh-muted);
  font-size: 22rpx;
}

.registration {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--yh-line);
}

.registration:last-child {
  border-bottom: 0;
}

.registration__head,
.registration__foot {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: space-between;
}

.registration__title {
  min-width: 0;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-more {
  display: block;
  margin: 20rpx auto 0;
}

.item--pressed {
  opacity: 0.75;
}

.hint {
  display: block;
  margin-bottom: 12rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
}

.action-error {
  display: block;
  margin-bottom: 12rpx;
  color: var(--yh-red);
  font-size: 24rpx;
}

.security-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx dashed var(--yh-line);
}

.security-row--action {
  color: var(--yh-green);
}
