<import src="../../templates/match-card.wxml" />
<import src="../../templates/filter-drawer.wxml" />

<view class="container schedule">
  <view class="page-head">
    <text class="page-head__eyebrow">MATCHDAY</text>
    <view class="page-head__title">比赛</view>
    <text class="muted">共 {{feed.loaded ? feed.total : '—'}} 场比赛 · 按开赛时间降序</text>
  </view>

  <template is="filter-trigger" />

  <view wx:if="{{feed.loading && feed.items.length === 0}}" class="state">
    <van-loading size="20px">加载中…</van-loading>
  </view>

  <view wx:elif="{{feed.error && feed.items.length === 0}}" class="state">
    <text class="muted">{{feed.error}}</text>
    <view class="btn btn--primary btn--small" bindtap="retry" hover-class="btn--pressed">重试</view>
  </view>

  <view wx:elif="{{feed.loaded && feed.items.length === 0}}" class="state">
    <van-empty description="暂无符合条件的比赛" />
    <view class="btn btn--small btn--outline" bindtap="resetFilters" hover-class="btn--pressed">重置筛选</view>
  </view>

  <view wx:else class="match-list">
    <view
      class="match-card"
      wx:for="{{feed.items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
      hover-class="card--pressed"
    >
      <template is="match-card" data="{{match: item}}" />
    </view>
  </view>

  <view wx:if="{{feed.items.length > 0}}" class="feed-footer">
    <van-loading wx:if="{{feed.loadingMore}}" size="18px">加载中…</van-loading>
    <block wx:elif="{{feed.error}}">
      <text class="muted">{{feed.error}}</text>
      <view class="btn btn--small btn--outline" bindtap="retryFooter" hover-class="btn--pressed">重试加载</view>
    </block>
    <text wx:elif="{{feed.page >= feed.totalPages}}" class="muted">已显示全部</text>
    <text wx:else class="muted">上拉加载更多</text>
  </view>
</view>

<template
  is="filter-drawer-popup"
  data="{{filtersOpen: filtersOpen, typeVisible: true, typeOptions: typeOptions, typeIndex: typeIndex, venueVisible: venueVisible, venue: form.venue, statusVisible: true, statusOptions: statusOptions, statusIndex: statusIndex, month: form.month, monthDraft: monthPickerValue, startDate: form.startDate, endDate: form.endDate, timeFilterMin: timeFilterMin, timeFilterMax: timeFilterMax}}"
/>

<template
  is="time-range-popup"
  data="{{rangeOpen: rangeOpen, rangeDraftStart: rangeDraftStart, rangeDraftEnd: rangeDraftEnd, timeFilterMin: timeFilterMin, timeFilterMax: timeFilterMax}}"
/>
