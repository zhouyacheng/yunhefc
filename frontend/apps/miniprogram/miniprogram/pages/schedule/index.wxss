.schedule {
  padding-bottom: calc(var(--yh-page-pad-y) + env(safe-area-inset-bottom));
}

.schedule-filters__trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 12rpx 32rpx;
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-green);
  border-radius: 999rpx;
}

.feed-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0 8rpx;
  font-size: 24rpx;
}
