<view class="page">
  <view class="hint">BASE_URL：{{baseUrl}}</view>
  <input class="input" placeholder="测试手机号" value="{{phone}}" bindinput="onPhoneInput" />
  <input class="input" placeholder="测试密码" password value="{{password}}" bindinput="onPasswordInput" />

  <button class="btn" type="primary" bindtap="runAuto" disabled="{{running}}">A. 自动 Cookie（微信网络栈）</button>
  <button class="btn" bindtap="runManual" disabled="{{running}}">B. 手动 Cookie 回传</button>
  <button class="btn" bindtap="checkMe" disabled="{{running}}">冷启动后检查 /me</button>
  <button class="btn" bindtap="reset" disabled="{{running}}">清空</button>

  <view class="verdict {{verdictClass}}" wx:if="{{verdict}}">{{verdict}}</view>

  <view class="step" wx:for="{{steps}}" wx:key="idx">
    <view class="step-head">{{item.name}} → {{item.status}}</view>
    <view class="step-body">{{item.message}}</view>
    <view class="step-meta" wx:if="{{item.meta}}">{{item.meta}}</view>
  </view>
</view>
