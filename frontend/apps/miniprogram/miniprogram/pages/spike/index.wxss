.page {
  padding: 24rpx;
}

.hint {
  color: #646a73;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.input {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.btn {
  margin-top: 20rpx;
}

.verdict {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.verdict.ok {
  background: #e8f7ee;
  color: #1a7f47;
}

.verdict.bad {
  background: #fdecec;
  color: #c0392b;
}

.step {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.step-head {
  font-weight: 600;
}

.step-body {
  margin-top: 8rpx;
  color: #1f2329;
  word-break: break-all;
}

.step-meta {
  margin-top: 8rpx;
  color: #8a9099;
  font-size: 22rpx;
  word-break: break-all;
}
