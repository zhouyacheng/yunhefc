.team-head {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 48rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.team-head__side {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
  align-items: flex-end;
}

.team-season {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.team-head__link {
  padding: 12rpx 4rpx;
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.team-season__select {
  display: inline-flex;
  align-items: center;
  min-height: 68rpx;
  white-space: nowrap;
  padding: 12rpx 18rpx;
  color: var(--yh-ink);
  font-size: 26rpx;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: 18rpx;
}

.team-groups {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
}

.team-group__head {
  display: flex;
  gap: 24rpx;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.team-group__title {
  display: flex;
  gap: 16rpx;
  align-items: baseline;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.team-roster {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.player-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 32rpx;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.player-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.player-card__avatar {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
  background: var(--yh-slate-soft);
}

.player-card__avatar--fallback {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--yh-green);
  font-weight: 800;
}

.player-card__jersey {
  color: var(--yh-line);
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -0.05em;
}

.player-card__body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.player-card__name {
  font-size: 30rpx;
  font-weight: 700;
}

.player-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.player-card__stats {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  color: var(--yh-muted);
  border-top: 1rpx dashed var(--yh-line);
}

.small {
  font-size: 24rpx;
}
