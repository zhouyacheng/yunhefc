/* 跨页面共用控件：按钮、状态/类型 pill、筛选抽屉与时间筛选字段。 */

.btn {
  box-sizing: border-box;
  display: inline-block;
  min-height: 88rpx;
  padding: 0 32rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--yh-radius-sm);
}

.btn--primary {
  background: linear-gradient(135deg, var(--yh-green-bright), var(--yh-green));
  box-shadow: var(--yh-green-shadow);
}

.btn--small {
  min-height: 72rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.btn--outline {
  box-sizing: border-box;
  color: var(--yh-green);
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-green);
  box-shadow: none;
}

.btn--danger-plain {
  box-sizing: border-box;
  color: var(--yh-red);
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-red);
  box-shadow: none;
}

.btn--block {
  display: block;
  width: 100%;
}

.btn--pressed {
  opacity: 0.86;
  transform: translateY(1rpx);
}

.btn--disabled {
  color: var(--yh-muted);
  background: var(--yh-slate-soft);
  box-shadow: none;
}

.status-pill,
.type-pill {
  box-sizing: border-box;
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  border-radius: 999rpx;
}

.status-pill {
  color: var(--yh-slate-ink);
  background: var(--yh-slate-soft);
}

.status-pill--open {
  color: var(--yh-green-ink);
  background: var(--yh-green-soft);
}

.status-pill--closed,
.status-pill--loss {
  color: var(--yh-slate-ink);
  background: var(--yh-line);
}

.status-pill--locked {
  color: var(--yh-blue-ink);
  background: var(--yh-blue-soft);
}

.status-pill--live,
.status-pill--win {
  color: #ffffff;
  background: var(--yh-red);
}

.status-pill--finished {
  color: var(--yh-indigo-ink);
  background: var(--yh-indigo-soft);
}

.status-pill--postponed,
.status-pill--draw,
.status-pill--soon {
  color: var(--yh-amber-ink);
  background: var(--yh-amber-soft);
}

.status-pill--cancelled,
.status-pill--muted {
  color: var(--yh-muted);
  background: var(--yh-slate-soft);
}

.status-pill--admin {
  color: var(--yh-purple-ink);
  background: var(--yh-purple-soft);
}

.type-pill--external {
  color: var(--yh-indigo-ink);
  background: var(--yh-indigo-soft);
}

.type-pill--internal {
  color: var(--yh-green-ink);
  background: var(--yh-green-soft);
}

.type-pill--training {
  color: var(--yh-blue-ink);
  background: var(--yh-blue-soft);
}

.type-pill--friendly {
  color: var(--yh-amber-ink);
  background: var(--yh-amber-soft);
}

/* 球员星级：SVG 描边与 C 端 SkillStars 一致（24×24 path，满金/半星裁切/空星描边）。 */

.skill-stars {
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  line-height: 1;
}

.skill-star {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.skill-star--empty {
  background-image: url("data:image/svg+xml;base64,");
}

.skill-star--full {
  background-image: url("data:image/svg+xml;base64,");
}

.skill-star--half {
  background-image: url("data:image/svg+xml;base64,");
}

/* 筛选入口、抽屉与时间筛选字段：赛程、活动共用。 */

.filter-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 12rpx 32rpx;
  color: var(--yh-green);
  font-size: 26rpx;
  font-weight: 600;
  background: var(--yh-surface);
  border: 1rpx solid var(--yh-green);
  border-radius: 999rpx;
}

.filter-drawer {
  box-sizing: border-box;
  height: 70vh;
  padding: 32rpx var(--yh-page-pad-x) calc(32rpx + env(safe-area-inset-bottom));
}

.filter-drawer__head {
  margin-bottom: 16rpx;
}

.filter-drawer__title {
  font-size: 34rpx;
  font-weight: 700;
}

.filter-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--yh-line);
}

.filter-field__label {
  flex: 0 0 140rpx;
  color: var(--yh-muted);
  font-size: 26rpx;
}

.filter-field picker {
  flex: 1;
  min-width: 0;
}

.filter-field__control {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.filter-field__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--yh-ink);
  font-size: 28rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-field__input {
  flex: 1;
  min-width: 0;
  color: var(--yh-ink);
  font-size: 28rpx;
  text-align: right;
}

.filter-field__clear {
  flex: 0 0 auto;
  color: var(--yh-green);
  font-size: 24rpx;
}

.filter-drawer__actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 32rpx;
}

.range-sheet {
  box-sizing: border-box;
  padding: 32rpx var(--yh-page-pad-x) calc(32rpx + env(safe-area-inset-bottom));
}

.range-sheet__actions {
  justify-content: space-between;
}
