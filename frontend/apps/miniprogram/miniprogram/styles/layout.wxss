/* 跨页面共用布局：加载/错误/空态、页头与 emoji 信息行。 */

/* emoji 信息行：emoji 用 view 承载（<text> 上 transform 不生效），与文本按视觉中线对齐。
   Apple Color Emoji 墨迹重心比中文低约 1 个 css px，24~26rpx 字号下取 2rpx 校正。 */
.emoji-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.emoji-icon {
  flex: none;
  line-height: 1;
  transform: translateY(-2rpx);
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 40rpx;
}

.state--inline {
  padding: 32rpx 0;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-head__eyebrow {
  display: block;
  color: var(--yh-gold);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.page-head__title {
  margin: 8rpx 0 6rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.03em;
}

/* 分享封面画布：必须实际渲染才能导出，移出可视区而不是 display:none；尺寸由页面 style 注入。 */
.share-cover-canvas {
  position: fixed;
  top: 0;
  left: -2000px;
  pointer-events: none;
}
