/* 比赛卡片：C02 信息结构，MP06 首页最近比赛与 MP03 比赛列表共用。 */

.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 36rpx;
  background: var(--yh-surface);
  border: 2rpx solid var(--yh-line);
  border-radius: var(--yh-radius);
  box-shadow: var(--yh-shadow-sm);
}

.card--pressed {
  opacity: 0.9;
}

.match-card__top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.match-card__date,
.match-card__ordinal {
  min-width: 0;
  overflow: hidden;
  color: var(--yh-muted);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-card__date {
  flex: 0 0 auto;
  margin-right: auto;
}

.match-card__ordinal {
  flex: 0 1 auto;
}

.match-card__teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 16rpx;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.match-card__score {
  color: var(--yh-ink);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.04em;
  white-space: nowrap;
}

.match-card__foot {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--yh-line);
}

.match-card__venue {
  min-width: 0;
  overflow: hidden;
  color: var(--yh-muted);
  font-size: 24rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-card__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  color: var(--yh-muted);
  font-size: 24rpx;
}

.match-card__stat {
  display: flex;
  gap: 8rpx;
  align-items: baseline;
}

.match-card__stat:nth-child(2) {
  justify-content: center;
}

.match-card__stat:nth-child(3) {
  justify-content: flex-end;
}

.match-card__stat-value {
  color: var(--yh-ink);
  font-size: 26rpx;
  font-weight: 700;
}

.team-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-name--winner {
  box-sizing: border-box;
  justify-self: center;
  max-width: 100%;
  padding: 4rpx 16rpx;
  color: #ffffff;
  background: var(--yh-red);
  border-radius: 14rpx;
}
