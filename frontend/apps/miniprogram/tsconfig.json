{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["miniprogram-api-typings", "node"]
  },
  "include": ["miniprogram/**/*.ts", "tests/**/*.ts"]
}
